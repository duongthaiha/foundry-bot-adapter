FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=<foundry-agent-name>
FOUNDRY_API_VERSION=2025-11-15-preview
FOUNDRY_MAX_METADATA_KEYS=7
FOUNDRY_METADATA_ALLOWLIST=
AZURE_AI_TOKEN_SCOPE=https://ai.azure.com/.default

# New Bot Service default:
MicrosoftAppType=UserAssignedMSI
MicrosoftAppId=<user-assigned-managed-identity-client-id>
MicrosoftAppTenantId=<tenant-id>
MicrosoftAppPassword=

# Existing Bot Service SingleTenant alternative:
# MicrosoftAppType=SingleTenant
# MicrosoftAppId=<existing-bot-app-registration-client-id>
# MicrosoftAppTenantId=<tenant-id>
# MicrosoftAppPassword=<client-secret>

ENABLE_LOCAL_TEST_ENDPOINTS=false
LOCAL_TEST_API_KEY=
